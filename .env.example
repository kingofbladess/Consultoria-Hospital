# Conexión a PostgreSQL
DATABASE_URL="postgresql://usuario:clave@localhost:5432/consultoria_hospital?schema=public"

# Datos del centro de salud que aparecen en los récipes
CENTRO_NOMBRE="Consultoría Hospital"
CENTRO_RIF="J-00000000-0"
CENTRO_DIRECCION="Caracas, Venezuela"

# Proveedor de medicamentos para importar al vademécum: "local" (sin API externa)
PROVEEDOR_MEDICAMENTOS="local"

# Firma de las sesiones: cadena aleatoria de 32 caracteres o más
# (genere una con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
AUTH_SECRET=""

# Usuarios iniciales que crea npm run db:seed (cambie las contraseñas)
ADMIN_EMAIL="admin@hospital.local"
ADMIN_CLAVE=""
RECEPCION_EMAIL="recepcion@hospital.local"
RECEPCION_CLAVE=""
